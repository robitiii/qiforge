{
  "name": "zyngo-oracle-1",
  "version": "0.0.1",
  "description": "ZynGo Agentic Oracle for IXO Ecosystem Domain Operations and Claims Evaluation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "chat": "tsx src/chat-cli.ts",
    "start": "node dist/main.js",
    "start:mem": "node --max-old-space-size=1536 --heapsnapshot-near-heap-limit=3 --heapsnapshot-signal=SIGUSR2 --inspect=9229 dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:integration": "vitest run --mode int"
  },
  "dependencies": {
    "@ixo/oracle-runtime": "workspace:*",
    "@ixo/ucan": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.1",
    "langchain": "1.4.2",
    "matrix-js-sdk": "^37.11.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@bull-board/api": "^7.2.1",
    "@bull-board/express": "^7.2.1",
    "@bull-board/nestjs": "^7.2.1",
    "@ixo/vitest-config": "workspace:*",
    "@langchain/core": "1.1.48",
    "@nestjs/bullmq": "^11.0.4",
    "@types/node": "^22.10.7",
    "bullmq": "^5.78.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@digitalbazaar/http-client": "4.2.0"
  }
}
